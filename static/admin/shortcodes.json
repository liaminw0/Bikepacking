[
  {
    "name": "YouTube",
    "description": "Embed a YouTube video",
    "template": "{{< youtube id=\"${id}\" >}}",
    "fields": [
      { "key": "id", "label": "Video ID", "type": "text" }
    ]
  },
  {
    "name": "Callout",
    "description": "Info/warn/tip callout",
    "template": "{{< callout kind=\"${kind}\" >}}${text}{{< /callout >}}",
    "fields": [
      { "key": "kind", "label": "Kind", "type": "select", "options": ["info", "warn", "tip"] },
      { "key": "text", "label": "Text", "type": "textarea" }
    ]
  },
  {
    "name": "OpenStreetMap",
    "description": "Embed a map with marker",
    "template": "{{< openstreetmap lat=\"${lat}\" lon=\"${lon}\" zoom=\"${zoom}\" delta=\"${delta}\" >}}",
    "fields": [
      { "key": "lat", "label": "Latitude", "type": "text" },
      { "key": "lon", "label": "Longitude", "type": "text" },
      { "key": "zoom", "label": "Zoom (optional)", "type": "text" },
      { "key": "delta", "label": "Bounds delta (optional)", "type": "text" }
    ]
  }
]
